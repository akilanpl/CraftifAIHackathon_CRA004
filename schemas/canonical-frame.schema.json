{
  "$defs": {
    "Detection": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "class_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Class Name",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        }
      },
      "required": [
        "class_name",
        "confidence",
        "bbox"
      ],
      "title": "Detection",
      "type": "object"
    },
    "NativeEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "zone_id": {
          "minLength": 1,
          "title": "Zone Id",
          "type": "string"
        },
        "track_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "event_type": {
          "enum": [
            "zone_entry",
            "zone_exit"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "event_id",
        "zone_id",
        "event_type"
      ],
      "title": "NativeEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "camera_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Camera Id",
      "type": "string"
    },
    "frame_width": {
      "exclusiveMinimum": 0,
      "maximum": 32768,
      "title": "Frame Width",
      "type": "integer"
    },
    "frame_height": {
      "exclusiveMinimum": 0,
      "maximum": 32768,
      "title": "Frame Height",
      "type": "integer"
    },
    "detections": {
      "items": {
        "$ref": "#/$defs/Detection"
      },
      "maxItems": 1000,
      "title": "Detections",
      "type": "array"
    },
    "native_events": {
      "items": {
        "$ref": "#/$defs/NativeEvent"
      },
      "maxItems": 1000,
      "title": "Native Events",
      "type": "array"
    },
    "analytics_mode": {
      "default": "detections",
      "enum": [
        "detections",
        "native"
      ],
      "title": "Analytics Mode",
      "type": "string"
    },
    "source_name": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Name"
    },
    "fps": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fps"
    },
    "inference_latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inference Latency Ms"
    },
    "gpu_name": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gpu Name"
    },
    "video_url": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Video Url"
    }
  },
  "required": [
    "timestamp",
    "camera_id",
    "frame_width",
    "frame_height"
  ],
  "title": "Frame",
  "type": "object"
}

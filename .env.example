# Copy values to your shell (the backend does not implicitly load this file).
SENTINEL_MODE=live
# Live and synthetic use different defaults. Avoid overriding DB paths across modes.
# SENTINEL_DB_PATH=data/sentinel.sqlite3
# SENTINEL_JSONL_PATH=data/incidents.jsonl
SENTINEL_TRACK_TIMEOUT=5
SENTINEL_SOURCE_TIMEOUT=10
# Enable only after writing and testing a parser against genuine metadata:
# SENTINEL_PIPEGEN_PARSER=your_module:parse

# Built-in mapper: activate only after reviewing genuine output and field mapping:
# SENTINEL_PIPEGEN_PARSER=backend.adapters.field_mapping:parse
# SENTINEL_FIELD_MAPPING=/absolute/path/to/config/local-pipegen-mapping.json
